{
  "name": "lampstack",
  "version": "1.0.0",
  "description": "COLORS LAMP stack web app (Node is used only for linting tools)",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:js": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nickocade14/LampStack.git"
  },
  "author": "Nicolas Cadena",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Nickocade14/LampStack/issues"
  },
  "homepage": "https://github.com/Nickocade14/LampStack#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  },
  "private": true
}
