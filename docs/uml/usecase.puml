@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam actorBorderColor #334155
skinparam actorBackgroundColor #F1F5F9
skinparam usecaseBackgroundColor #EFF6FF
skinparam usecaseBorderColor #2563EB
skinparam rectangleBorderColor #64748B
skinparam rectangleBackgroundColor white
skinparam noteBackgroundColor #FFFBEB
skinparam noteBorderColor #D6B65A
skinparam noteFontSize 13
skinparam dpi 140

title COLORS - Use Case Diagram

actor User

rectangle "COLORS Web Application\nBrowser + PHP API + MySQL" {
  usecase "Log In" as Login
  usecase "Search Colors" as Search
  usecase "Add Color" as Add
  usecase "Log Out" as Logout

}

User -- Login
User -- Search
User -- Add
User -- Logout

legend bottom
  Log In: valid credentials open color.html; invalid credentials show an error on index.html.
  Search Colors / Add Color: operate on colors using the userId submitted by the browser.
  Log Out: immediately available on color.html; clears browser state without an API call.
  Normal UI flow requires login first. This is not an include relationship or a server-side session check.
  MySQL is internal to the system boundary. Cookie expiration is 20 minutes.
endlegend
@enduml
